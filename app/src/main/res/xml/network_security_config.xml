<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ceochandigarh.gov.in</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/emsign_root_ca_g1" />
            <certificates src="@raw/chandigarh_emsign_root_tls_ca_g1" />
            <certificates src="@raw/em_dv_tls_ca_g2a1" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">webapp.ceo.kerala.gov.in</domain>
    </domain-config>
</network-security-config>

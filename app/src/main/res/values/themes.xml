<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VoterList2026" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="colorPrimary">@color/indigo_primary</item>
        <item name="colorPrimaryDark">@color/indigo_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/indigo_primary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorAccent">@color/green_primary</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_primary</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="colorSurfaceVariant">@color/surface_light</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/surface_light</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
        <item name="colorOutline">@color/black</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.VoterList2026.BodyMedium</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="TextAppearance.VoterList2026.BodyMedium" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Splash screen using AndroidX core-splashscreen -->
    <style name="Theme.VoterList2026.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/indigo_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.VoterList2026</item>
    </style>

</resources>
